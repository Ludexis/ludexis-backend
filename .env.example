# Local development: the backend runs on the host, PostgreSQL and Redis come from docker-compose.dev.yml.
DATABASE_URL=postgresql+psycopg://ludexis:ludexis@localhost:5432/ludexis

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Left empty, a secret is generated once into CONFIG_DIR. If set, at least 32 characters: openssl rand -hex 32
JWT_SECRET_KEY=
CONFIG_DIR=./config

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

JOB_MAX_RETRIES=5
JOB_RETRY_BACKOFF_MAX=300

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAMGRIDDB_API_KEY=
# Folder of extra metadata provider modules (*.py), loaded at startup
PROVIDER_PLUGINS_DIR=

ARTWORK_STORAGE_PATH=./artwork

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Created on first start when the database has no accounts; it must choose a new password at its first sign-in.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
