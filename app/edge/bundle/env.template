# Ludexis edge device "{name}". This file holds the device's token: keep it private.

# The Ludexis server this device reports to, and its token (Admin > Edge on the server can rotate it).
LUDEXIS_SERVER_URL={server_url}
LUDEXIS_EDGE_TOKEN={token}

# Shown on the server; the installer fills in this machine's name.
EDGE_HOSTNAME=

# Image tag of the edge device; keep it on the server's release.
LUDEXIS_VERSION=latest

# Linux only: extra folders, separated by ":", holding library folders outside /media, /mnt and /run/media.
# Run "ludexis-edge restart" after changing it.
EDGE_ROOTS=

TZ=UTC
